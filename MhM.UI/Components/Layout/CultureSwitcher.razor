@inject NavigationManager Navigation

<div class="lang-switcher">
    <Icon CustomIconName="bi bi-globe2" />
    <label class="visually-hidden" for="culture-select">Sprache</label>
    <select id="culture-select" class="lang-select" value="@CurrentCulture" @onchange="ChangeCulture">
        <option value="de-DE">DE</option>
        <option value="en-US">EN</option>
    </select>
</div>

@code {
    private string CurrentPath
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
            return string.IsNullOrWhiteSpace(relative) ? "/" : $"/{relative}";
        }
    }

    private string BuildHref(string culture)
        => $"/culture/set?culture={Uri.EscapeDataString(culture)}&redirectUri={Uri.EscapeDataString(CurrentPath)}";

    private string CurrentCulture => System.Globalization.CultureInfo.CurrentUICulture.Name;

    private void ChangeCulture(ChangeEventArgs args)
    {
        var culture = args.Value?.ToString();
        if (culture is "de-DE" or "en-US")
        {
            Navigation.NavigateTo(BuildHref(culture), forceLoad: true);
        }
    }
}
