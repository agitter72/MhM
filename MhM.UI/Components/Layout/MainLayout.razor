@inherits LayoutComponentBase
@inject UiLocalizer T

<div class="app-shell">
    <button class="mobile-nav-backdrop @(IsMobileNavOpen ? "is-visible" : null)"
            type="button"
            aria-label="Menü schließen"
            @onclick="CloseMobileNav">
    </button>

    <aside class="sidebar @(IsMobileNavOpen ? "is-open" : null)">
        <div class="sidebar-brand">
            <div class="sidebar-brand-icon">MhM</div>
            <div class="sidebar-brand-copy">
                <div class="sidebar-brand-title">@T["App.Title"]</div>
                <div class="sidebar-brand-subtitle">@T["Layout.SidebarSubtitle"]</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="sidebar-nav-title">@T["Nav.Platform"]</div>

            <NavLink href="/" Match="NavLinkMatch.All" class="sidebar-link" @onclick="CloseMobileNav">
                <span class="sidebar-link-icon"><Icon CustomIconName="bi bi-house-door" /></span>
                <span class="sidebar-link-label">@T["Nav.Home"]</span>
            </NavLink>

            <NavLink href="/auftraege" class="sidebar-link" @onclick="CloseMobileNav">
                <span class="sidebar-link-icon"><Icon CustomIconName="bi bi-card-checklist" /></span>
                <span class="sidebar-link-label">@T["Nav.Listings"]</span>
            </NavLink>

            <NavLink href="/auftraege/neu" class="sidebar-link" @onclick="CloseMobileNav">
                <span class="sidebar-link-icon"><Icon CustomIconName="bi bi-plus-circle" /></span>
                <span class="sidebar-link-label">@T["Nav.NewListing"]</span>
            </NavLink>

            <NavLink href="/helfer" class="sidebar-link" @onclick="CloseMobileNav">
                <span class="sidebar-link-icon"><Icon CustomIconName="bi bi-people" /></span>
                <span class="sidebar-link-label">@T["Nav.Helpers"]</span>
            </NavLink>

            <AuthorizeView>
                <Authorized>
                    <NavLink href="/mein" class="sidebar-link" @onclick="CloseMobileNav">
                        <span class="sidebar-link-icon"><Icon CustomIconName="bi bi-person" /></span>
                        <span class="sidebar-link-label">Mein</span>
                    </NavLink>
                </Authorized>
                <NotAuthorized>
                    <NavLink href="/account/login" class="sidebar-link" @onclick="CloseMobileNav">
                        <span class="sidebar-link-icon"><Icon CustomIconName="bi bi-box-arrow-in-right" /></span>
                        <span class="sidebar-link-label">Anmelden</span>
                    </NavLink>

                    <NavLink href="/account/register" class="sidebar-link" @onclick="CloseMobileNav">
                        <span class="sidebar-link-icon"><Icon CustomIconName="bi bi-person-plus" /></span>
                        <span class="sidebar-link-label">Registrieren</span>
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </nav>

    </aside>

    <div class="content-area">
        <header class="topbar">
            <div class="topbar-summary">
                <button class="mobile-nav-toggle btn btn-light"
                        type="button"
                        aria-label="Menü öffnen"
                        aria-expanded="@IsMobileNavOpen"
                        @onclick="ToggleMobileNav">
                    <Icon CustomIconName="bi bi-list" />
                </button>

                <div class="eyebrow">@T["Layout.TopbarEyebrow"]</div>
                <h1 class="topbar-title">@T["Layout.TopbarTitle"]</h1>
            </div>

            <div class="topbar-actions">
                <button class="theme-toggle btn btn-light"
                        type="button"
                        aria-label="Farbschema wechseln"
                        title="Hell-/Dunkelmodus wechseln"
                        onclick="window.theme.toggle()">
                    <span class="theme-icon theme-icon-moon" aria-hidden="true"><Icon CustomIconName="bi bi-moon-stars" /></span>
                    <span class="theme-icon theme-icon-sun" aria-hidden="true"><Icon CustomIconName="bi bi-sun" /></span>
                </button>
                <CultureSwitcher />
                <a class="btn btn-primary topbar-create" href="/auftraege/neu"><Icon CustomIconName="bi bi-plus-lg" /> @T["Nav.NewListing"]</a>

                <AuthorizeView>
                    <Authorized Context="authState">
                        <div class="notification-center" @ref="notificationCenterElement">
                            <button class="notification-toggle btn btn-light"
                                    type="button"
                                    aria-label="Benachrichtigungen"
                                    aria-expanded="@isNotificationCenterOpen"
                                    @onclick="ToggleNotificationCenterAsync">
                                <Icon CustomIconName="bi bi-bell" />
                                @if (unreadNotificationCount > 0)
                                {
                                    <span class="notification-badge">@(unreadNotificationCount > 99 ? "99+" : unreadNotificationCount)</span>
                                }
                            </button>

                            @if (isNotificationCenterOpen)
                            {
                                <div class="notification-popover">
                                    <div class="notification-popover-header">
                                        <strong>Benachrichtigungen</strong>
                                        <span class="muted">@unreadNotificationCount ungelesen</span>
                                    </div>

                                    @if (notificationItems.Count == 0)
                                    {
                                        <div class="notification-empty">Keine Benachrichtigungen vorhanden.</div>
                                    }
                                    else
                                    {
                                        <div class="notification-list">
                                            @foreach (var notification in notificationItems)
                                            {
                                                <a class="notification-item @(notification.ReadUtc is null ? "notification-item--unread" : null)"
                                                   href="@notification.LinkUrl"
                                                   @onclick="CloseNotificationCenterAsync">
                                                    <div class="notification-item-head">
                                                        <span class="notification-pill">@GetNotificationTypeLabel(notification)</span>
                                                        <time datetime="@notification.CreatedUtc.ToString("O")">@FormatNotificationTimestamp(notification.CreatedUtc)</time>
                                                    </div>
                                                    <div class="notification-item-title">@notification.Title</div>
                                                    <div class="notification-item-text">@notification.Content</div>
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <a class="user-pill" href="/mein" aria-label="Mein Profil öffnen">
                            <div class="user-pill-avatar"><Icon CustomIconName="bi bi-person-fill" /></div>
                            <div>
                                <strong>@authState.User.Identity?.Name</strong>
                                <div class="muted">Angemeldet</div>
                            </div>
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-secondary topbar-login" href="/account/login">Anmelden</a>
                        <a class="btn btn-primary topbar-register" href="/account/register">Registrieren</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="page-content">
            @Body
        </main>
    </div>
</div>

<button class="return-to-top"
        type="button"
        aria-label="Zurück nach oben"
        title="Zurück nach oben"
        onclick="window.pageNavigation.scrollToTop()">
    <Icon CustomIconName="bi bi-arrow-up" />
</button>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss"><Icon CustomIconName="bi bi-x-lg" /></span>
</div>

@code {
    private bool IsMobileNavOpen;

    private void ToggleMobileNav() => IsMobileNavOpen = !IsMobileNavOpen;

    private void CloseMobileNav() => IsMobileNavOpen = false;
}
