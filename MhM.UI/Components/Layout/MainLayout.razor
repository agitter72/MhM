@inherits LayoutComponentBase
@inject UiLocalizer T

<div class="app-shell">
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="sidebar-brand-icon">MhM</div>
            <div>
                <div class="sidebar-brand-title">@T["App.Title"]</div>
                <div class="sidebar-brand-subtitle">@T["Layout.SidebarSubtitle"]</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="sidebar-nav-title">@T["Nav.Platform"]</div>

            <NavLink href="/" Match="NavLinkMatch.All" class="sidebar-link">
                <span class="sidebar-link-icon">⌂</span>
                <span>@T["Nav.Home"]</span>
            </NavLink>

            <NavLink href="/auftraege" class="sidebar-link">
                <span class="sidebar-link-icon">▣</span>
                <span>@T["Nav.Listings"]</span>
            </NavLink>

            <NavLink href="/auftraege/neu" class="sidebar-link">
                <span class="sidebar-link-icon">＋</span>
                <span>@T["Nav.NewListing"]</span>
            </NavLink>

            <NavLink href="/helfer" class="sidebar-link">
                <span class="sidebar-link-icon">◌</span>
                <span>@T["Nav.Helpers"]</span>
            </NavLink>
        </nav>

        <div class="sidebar-card">
            <div class="sidebar-card-label">MVP</div>
            <h3>@T["Layout.SidebarCardTitle"]</h3>
            <p>@T["Layout.SidebarCardText"]</p>
            <a class="btn btn-light" href="/auftraege/neu">@T["Layout.CreateListing"]</a>
        </div>
    </aside>

    <div class="content-area">
        <header class="topbar">
            <div>
                <div class="eyebrow">@T["Layout.TopbarEyebrow"]</div>
                <h1 class="topbar-title">@T["Layout.TopbarTitle"]</h1>
            </div>

            <div class="topbar-actions">
                <CultureSwitcher />
                <a class="btn btn-primary" href="/auftraege/neu">+ @T["Nav.NewListing"]</a>

                <AuthorizeView>
                    <Authorized>
                        <a class="btn btn-secondary" href="/account/logoff">Abmelden</a>
                        <div class="user-pill">
                            <div class="user-pill-avatar">👤</div>
                            <div>
                                <strong>@context.User.Identity?.Name</strong>
                                <div class="muted">Angemeldet</div>
                            </div>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-secondary" href="/account/login">Anmelden</a>
                        <a class="btn btn-light" href="/account/register">Registrieren</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="page-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
