@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="sidebar-brand-icon">MhM</div>
            <div>
                <div class="sidebar-brand-title">Menschen helfen Menschen</div>
                <div class="sidebar-brand-subtitle">Regional Dashboard</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="sidebar-nav-title">Plattform</div>

            <NavLink href="/" Match="NavLinkMatch.All" class="sidebar-link">
                <span class="sidebar-link-icon">⌂</span>
                <span>Dashboard</span>
            </NavLink>

            <NavLink href="/auftraege" class="sidebar-link">
                <span class="sidebar-link-icon">▣</span>
                <span>Aufträge</span>
            </NavLink>

            <NavLink href="/auftraege/neu" class="sidebar-link">
                <span class="sidebar-link-icon">＋</span>
                <span>Neuer Auftrag</span>
            </NavLink>

            <NavLink href="/helfer" class="sidebar-link">
                <span class="sidebar-link-icon">◌</span>
                <span>Helfer</span>
            </NavLink>
        </nav>

        <div class="sidebar-card">
            <div class="sidebar-card-label">MVP</div>
            <h3>Schnell Hilfe finden</h3>
            <p>Nachbarschaftshilfe, Kleinaufträge, Tausch und Bezahlung in einer Oberfläche.</p>
            <a class="btn btn-light" href="/auftraege/neu">Auftrag erstellen</a>
        </div>
    </aside>

    <div class="content-area">
        <header class="topbar">
            <div>
                <div class="eyebrow">Community Platform</div>
                <h1 class="topbar-title">MhM Control Center</h1>
            </div>

            <div class="topbar-actions">
                <a class="btn btn-primary" href="/auftraege/neu">+ Auftrag</a>
                <div class="user-pill">
                    <div class="user-pill-avatar">AG</div>
                    <div>
                        <strong>Workspace</strong>
                        <div class="muted">Blazor .NET 10</div>
                    </div>
                </div>
            </div>
        </header>

        <main class="page-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
