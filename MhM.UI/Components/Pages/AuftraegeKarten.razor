@using MhM.UI.Data.Models;

<div class="auftraege-karten-grid">
    @if (Items == null)
    {
        <LoadingSkeleton Variant="cards" Count="6" />
    }
    else if (Items.Count == 0)
    {
        <div class="panel">Keine Aufträge gefunden.</div>
    }
    else
    {
        @foreach (var item in Items)
        {
            var image = item.Images.FirstOrDefault();
            <AuftragKarte Href="@($"/auftraege/{item.Id}")"
                          Title="@item.Title"
                          PostalCode="@item.PostalCode"
                          City="@item.City"
                          BudgetMin="item.BudgetMin"
                          BudgetMax="item.BudgetMax"
                          ImageUrl="@(image is null ? null : $"/api/listing-images/{image.Id}")"
                          ImageAlt="@(image?.FileName)"
                          RequesterId="@(ShowRequester ? item.Requester.Id : null)"
                          RequesterDisplayName="@item.Requester.DisplayName"
                          RequesterUsername="@item.Requester.Username"
                          RequesterDescription="@item.Requester.Description"
                          RequesterHasImage="item.Requester.ProfileImageUpdatedUtc.HasValue"
                          RequesterImageVersion="item.Requester.ProfileImageUpdatedUtc?.Ticks ?? 0" />
        }
    }
</div>

@code {
    [Parameter]
    public List<Listing> Items { get; set; } = [];

    [Parameter]
    public bool ShowRequester { get; set; } = true;
}
