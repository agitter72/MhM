@page "/auftraege/neu"
@page "/auftraege/{Id:guid}/bearbeiten"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>@(IsEditMode ? T["TaskEdit.PageTitle.Edit"] : T["TaskEdit.PageTitle.New"])</PageTitle>

@if (isLoading)
{
    <LoadingSkeleton Variant="editor" />
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <section class="panel">
        <p class="text-danger">@loadError</p>
    </section>
}
else
{
    <section class="editor-header">
        <div>
            <div class="eyebrow">@T["TaskEdit.HeaderEyebrow"]</div>
            <h2>@(IsEditMode ? T["TaskEdit.HeaderEdit"] : T["TaskEdit.HeaderNew"])</h2>
            <p class="muted">@T["TaskEdit.HeaderText"]</p>
        </div>

        <div class="editor-badges">
            <span class="badge-soft">@T.Enum(model.Status)</span>
            <span class="badge-soft">@T.Enum(model.CompensationType)</span>
        </div>
    </section>

    <section class="editor-grid">
        <article class="panel panel-form">
            <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="@CurrentFormName">
                <DataAnnotationsValidator />
                <ValidationSummary />

                @if (!string.IsNullOrWhiteSpace(saveError))
                {
                    <div class="alert-error">@saveError</div>
                }

                <div class="form-section">
                    <div class="section-heading">
                        <div class="eyebrow">@T["TaskEdit.BasicData"]</div>
                        <h3>@T["TaskEdit.Details"]</h3>
                    </div>

                    <div class="form-grid">
                        <div class="field">
                            <label for="category">@T["TaskEdit.Category"]</label>
                            <InputSelect id="category" @bind-Value="model.CategoryId" class="field-input">
                                <option value="0">@T["General.Select"]</option>
                                @foreach (var category in categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => model.CategoryId" />
                        </div>

                        <div class="field field-full">
                            <label for="title">@T["TaskEdit.Title"]</label>
                            <InputText id="title" @bind-Value="model.Title" class="field-input" />
                            <ValidationMessage For="() => model.Title" />
                        </div>

                        <div class="field field-full">
                            <label for="description">@T["TaskEdit.Description"]</label>
                            <InputTextArea id="description" @bind-Value="model.Description" class="field-input field-textarea" rows="7" />
                            <ValidationMessage For="() => model.Description" />
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="section-heading">
                        <div class="eyebrow">@T["TaskEdit.CompensationSection"]</div>
                        <h3>@T["TaskEdit.Terms"]</h3>
                    </div>

                    <div class="form-grid">
                        <div class="field">
                            <label for="budgetMin">@T["TaskEdit.BudgetFrom"]</label>
                            <div class="money-input"><InputNumber id="budgetMin" @bind-Value="model.BudgetMin" class="field-input" step="0.01" inputmode="decimal" /><span>€</span></div>
                            <ValidationMessage For="() => model.BudgetMin" />
                        </div>

                        <div class="field">
                            <label for="budgetMax">@T["TaskEdit.BudgetTo"]</label>
                            <div class="money-input"><InputNumber id="budgetMax" @bind-Value="model.BudgetMax" class="field-input" step="0.01" inputmode="decimal" /><span>€</span></div>
                            <ValidationMessage For="() => model.BudgetMax" />
                        </div>

                        <div class="field">
                            <label for="compensation">@T["TaskEdit.Compensation"]</label>
                            <InputSelect id="compensation" @bind-Value="model.CompensationType" class="field-input">
                                @foreach (var compensationType in Enum.GetValues<CompensationType>())
                                {
                                    <option value="@compensationType">@T.Enum(compensationType)</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="field">
                            <label for="status">@T["TaskEdit.Status"]</label>
                            <InputSelect id="status" @bind-Value="model.Status" class="field-input" disabled="@(IsEditMode && isAdmin && model.Status is not ListingStatus.Entwurf and not ListingStatus.Offen)">
                                @foreach (var status in EditableStatuses)
                                {
                                    <option value="@status">@T.Enum(status)</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="section-heading">
                        <div class="eyebrow">@T["TaskEdit.LocationSection"]</div>
                        <h3>@T["TaskEdit.RegionDate"]</h3>
                    </div>

                    <div class="form-grid">
                        <div class="field">
                            <label for="postalCode">@T["TaskEdit.PostalCode"]</label>
                            <InputText id="postalCode" @bind-Value="model.PostalCode" class="field-input" />
                            <ValidationMessage For="() => model.PostalCode" />
                        </div>

                        <div class="field">
                            <label for="city">@T["TaskEdit.City"]</label>
                            <InputText id="city" @bind-Value="model.City" class="field-input" />
                            <ValidationMessage For="() => model.City" />
                        </div>

                        <div class="field">
                            <label for="preferredDate">@T["TaskEdit.PreferredDate"]</label>
                            <InputDate id="preferredDate" @bind-Value="model.PreferredDateLocal" class="field-input" />
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="section-heading">
                        <div class="eyebrow">Anhänge</div>
                        <h3>Bilder zum Auftrag</h3>
                    </div>

                    @if (existingImages.Count > 0)
                    {
                        <ImageCarousel Images="existingImages"
                                       OnDelete="DeleteImageAsync" />
                    }

                    @if (pendingImages.Count > 0)
                    {
                        <div class="pending-image-list" aria-label="Neu ausgewählte Bilder">
                            @foreach (var pending in pendingImages)
                            {
                                <div>
                                    <span><Icon CustomIconName="bi bi-image" /> @pending.FileName</span>
                                    <button type="button" class="btn btn-secondary" @onclick="() => RemovePendingImage(pending.Id)">Entfernen</button>
                                </div>
                            }
                        </div>
                    }

                    @if (existingImages.Count + pendingImages.Count < maxImages)
                    {
                        <div class="field field-full">
                            <label>
                                Bilder hinzufügen
                                <span class="muted">(max. @maxImages Stück, je max. 5 MB – JPEG oder PNG)</span>
                            </label>
                            <InputFile OnChange="OnImagesSelectedAsync"
                                       accept="image/jpeg,image/png"
                                       multiple
                                       class="field-input" />
                            @if (!string.IsNullOrWhiteSpace(imageUploadError))
                            {
                                <div class="alert-error">@imageUploadError</div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="muted">Maximale Anzahl von @maxImages Bildern erreicht.</p>
                    }
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">@T["General.Save"]</button>
                    <a href="/auftraege/@Id" class="btn btn-secondary">@T["General.Cancel"]</a>
                </div>
            </EditForm>
        </article>

        <aside class="panel panel-side listing-preview-panel">
            <div class="section-heading">
                <div class="eyebrow">@T["TaskEdit.Preview"]</div>
                <h3>@T["TaskEdit.PreviewTitle"]</h3>
            </div>

            <div class="listing-form-preview">
                <AuftragKarte Title="@(string.IsNullOrWhiteSpace(model.Title) ? T["TaskEdit.NoTitle"] : model.Title)"
                              PostalCode="@model.PostalCode"
                              City="@model.City"
                              PriceText="@FormatPreviewBudget()"
                              ImageUrl="@PreviewImageUrl"
                              ImageAlt="Vorschaubild des Auftrags"
                              RequesterId="currentUserProfile?.Id"
                              RequesterDisplayName="@(currentUserProfile?.DisplayName ?? string.Empty)"
                              RequesterUsername="@(currentUserProfile?.Username ?? string.Empty)"
                              RequesterDescription="@(currentUserProfile?.Description ?? string.Empty)"
                              RequesterHasImage="currentUserProfile?.ProfileImageUpdatedUtc.HasValue == true"
                              RequesterImageVersion="currentUserProfile?.ProfileImageUpdatedUtc?.Ticks ?? 0" />
            </div>
        </aside>
    </section>
}
