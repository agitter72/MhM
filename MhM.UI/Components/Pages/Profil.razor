@page "/profil"
@page "/profil/{Username}"

<PageTitle>@(profile is null ? "Profil" : $"{profile.DisplayName} (@{profile.Username})")</PageTitle>

@if (isLoading)
{
    <LoadingSkeleton Variant="profile" />
}
else if (profile is null)
{
    <section class="panel profile-not-found">
        <Icon CustomIconName="bi bi-person-x" />
        <h1>Profil nicht gefunden</h1>
        <p class="muted">Dieser Nutzer existiert nicht oder ist nicht mehr verfügbar.</p>
    </section>
}
else
{
    <div class="profile-page">
        <div class="profile-overview @(profile.HelperProfile is null ? "profile-overview--single" : null)">
        <section class="panel profile-header">
            <div class="profile-header-top">
                <ProfileAvatar UserId="profile.Id" DisplayName="@profile.DisplayName" HasImage="profile.ProfileImageUpdatedUtc.HasValue" ImageVersion="profile.ProfileImageUpdatedUtc?.Ticks ?? 0" CssClass="profile-page-avatar" />
                <div class="profile-header-actions">
                    @if (isOwnProfile)
                    {
                        <a class="btn btn-secondary profile-edit-button" href="/einstellungen?tab=personal"><Icon CustomIconName="bi bi-gear" /> Profil bearbeiten</a>
                    }
                    else if (currentUserId.HasValue)
                    {
                        <button type="button" class="btn btn-danger" @onclick="() => showReportForm = !showReportForm">
                            <Icon CustomIconName="bi bi-exclamation-triangle-fill fa-danger" /> Nutzer melden
                        </button>
                    }
                </div>
            </div>
            @if (showReportForm)
            {
                <div class="report-form">
                    <div class="field">
                        <label for="user-report-reason">Grund</label>
                        <InputSelect id="user-report-reason" @bind-Value="selectedReportReason" class="field-input">
                            <option value="">Bitte auswählen</option>
                            @foreach (var reason in ReportReasons.User) { <option value="@reason">@reason</option> }
                        </InputSelect>
                    </div>
                    @if (selectedReportReason == ReportReasons.Other)
                    {
                        <div class="field">
                            <label for="user-report-details">Was ist das Problem?</label>
                            <InputTextArea id="user-report-details" @bind-Value="reportDetails" class="field-input field-textarea" maxlength="2000" />
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(reportMessage)) { <p class="@(reportSucceeded ? "text-success" : "text-danger")">@reportMessage</p> }
                    <div class="button-group">
                        <button type="button" class="btn btn-danger" @onclick="ReportUserAsync">Meldung absenden</button>
                        <button type="button" class="btn btn-secondary" @onclick="() => showReportForm = false">Abbrechen</button>
                    </div>
                </div>
            }
            <div class="profile-identity-block">
                <h1>@profile.DisplayName</h1>
                <p class="profile-username">@@@profile.Username</p>
                <p class="profile-description">@(string.IsNullOrWhiteSpace(profile.Description) ? "Noch keine Profilbeschreibung." : profile.Description)</p>
                <div class="profile-meta">
                    <span><Icon CustomIconName="bi bi-geo-alt" /> @profile.City</span>
                    <span><Icon CustomIconName="bi bi-calendar3" /> Dabei seit @profile.CreatedUtc.ToLocalTime().ToString("MMMM yyyy")</span>
                    @if (profile.Verifications.HasFlag(VerificationLevel.Email)) { <span class="profile-verified"><Icon CustomIconName="bi bi-envelope-check" /> E-Mail bestätigt</span> }
                    @if (profile.Verifications.HasFlag(VerificationLevel.Phone)) { <span class="profile-verified"><Icon CustomIconName="bi bi-phone" /> Telefon bestätigt</span> }
                    @if (profile.Verifications.HasFlag(VerificationLevel.Identity)) { <span class="profile-verified"><Icon CustomIconName="bi bi-person-check-fill" /> Identität bestätigt</span> }
                    @if (profile.Verifications.HasFlag(VerificationLevel.Business)) { <span class="profile-verified"><Icon CustomIconName="bi bi-building-check" /> Gewerbe geprüft</span> }
                    @if (profile.Verifications.HasFlag(VerificationLevel.Qualification)) { <span class="profile-verified"><Icon CustomIconName="bi bi-award" /> Qualifikation geprüft</span> }
                </div>
            </div>
        </section>

        @if (profile.HelperProfile is not null)
        {
            <section class="panel profile-helper">
                <div class="profile-helper-heading">
                    <span class="profile-helper-icon" aria-hidden="true"><Icon CustomIconName="bi bi-tools" /></span>
                    <div><span class="eyebrow">Helferprofil</span><h2>@profile.HelperProfile.Title</h2></div>
                    <span class="profile-rating" title="@helperReviewCount Bewertung@(helperReviewCount == 1 ? string.Empty : "en")">
                        <Icon CustomIconName="bi bi-star-fill" />
                        <strong>@(helperRating?.ToString("0.0") ?? "Neu")</strong>
                        @if (helperReviewCount > 0)
                        {
                            <span>(@helperReviewCount)</span>
                        }
                    </span>
                </div>
                <p class="profile-helper-description">@profile.HelperProfile.Description</p>
                @if (GetHelperSkills(profile.HelperProfile).Count > 0)
                {
                    <div class="profile-skill-list" aria-label="Fähigkeiten">
                        @foreach (var skill in GetHelperSkills(profile.HelperProfile))
                        {
                            <span>@skill</span>
                        }
                    </div>
                }
                <dl class="profile-helper-facts">
                    <div><dt><Icon CustomIconName="bi bi-cash-coin" /> Stundensatz</dt><dd>@(profile.HelperProfile.HourlyRate?.ToString("N2") ?? "Nach Absprache")@(profile.HelperProfile.HourlyRate.HasValue ? " €" : null)</dd></div>
                    <div><dt><Icon CustomIconName="bi bi-geo-alt" /> Einsatzradius</dt><dd>@profile.HelperProfile.RadiusKm km</dd></div>
                    <div><dt><Icon CustomIconName="bi bi-arrow-left-right" /> Tausch</dt><dd>@(profile.HelperProfile.OffersBarter ? "Möglich" : "Nicht angeboten")</dd></div>
                    <div><dt><Icon CustomIconName="bi bi-check2-circle" /> Aufträge</dt><dd>@acceptedHelperListingCount angenommen</dd></div>
                </dl>
            </section>
        }
        </div>

        <section class="profile-listings">
            <div class="profile-section-heading">
                <div><span class="eyebrow">Aufträge</span><h2>Aufträge von @profile.DisplayName</h2></div>
                <span class="badge-soft">@listings.Count</span>
            </div>
            @if (listings.Count == 0)
            {
                <div class="panel"><p class="muted">Noch keine öffentlichen Aufträge vorhanden.</p></div>
            }
            else
            {
                <AuftraegeKarten Items="listings" ShowRequester="false" />
            }
        </section>
    </div>
}
