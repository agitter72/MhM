@page "/auftraege/{ListingId:guid}"

<PageTitle>Auftrag Details</PageTitle>

@if (isLoading)
{
    <div class="panel">Lädt...</div>
}
else if (item is null)
{
    <div class="panel">Auftrag wurde nicht gefunden.</div>
}
else
{
    var applyModel = GetApplicationModel(item.Id);

    <div class="auftrag-detail-page">
        <section class="panel auftrag-detail-header">
            <div>
                <div class="eyebrow">Auftrag</div>
                <h1>@item.Title</h1>
            </div>

            <div class="listing-card-actions">
                <a class="btn btn-secondary" href="/auftraege">Zurück</a>
                <a class="btn btn-secondary" href="@($"/auftraege/{item.Id}/bearbeiten")">Bearbeiten</a>
                <a class="btn btn-secondary" href="@($"/auftraege/{item.Id}/vergabe")">Vergabe</a>
            </div>
        </section>

        <div class="auftrag-detail-content">
            <section class="panel auftrag-detail-media-panel">
                <div class="listing-card-media">
                    @if (item.Images.Count > 0)
                    {
                        <div class="listing-card-media-inner">
                            <ImageCarousel Images="item.Images.ToList()" />
                        </div>
                    }
                    else
                    {
                        <div class="listing-card-placeholder">
                            <span>Kein Bild verfügbar</span>
                        </div>
                    }
                </div>
            </section>

            <section class="panel auftrag-detail-data-panel">
                <div class="listing-chip-row">
                    <label>Vergütung: </label><span class="badge-soft">@T.Enum(item.CompensationType)</span>
                    <label>Status: </label><span class="badge-soft">@T.Enum(item.Status)</span>
                </div>
            </section>

            <section class="panel auftrag-detail-data-panel">
                <div class="listing-card-body">

                    <table class="auftrag-detail-table">
                        <tbody>
                            <tr>
                                <th colspan="2">Worum gehts:</th>
                            </tr>
                            <tr>
                                <td colspan="2" class="left">@item.Description</td>
                            </tr>
                            <tr>
                                <th>Kategorie</th>
                                <td>@item.Category.Name</td>
                            </tr>
                            <tr>
                                <th>Erstellt von</th>
                                <td>@item.Requester.DisplayName</td>
                            </tr>
                            <tr>
                                <th>Ort</th>
                                <td>@item.PostalCode @item.City</td>
                            </tr>
                            <tr>
                                <th>Koordinaten</th>
                                <td>@item.Latitude, @item.Longitude</td>
                            </tr>
                            <tr>
                                <th>Vergütung</th>
                                <td>@T.Enum(item.CompensationType)</td>
                            </tr>
                            <tr>
                                <th>Status</th>
                                <td>@T.Enum(item.Status)</td>
                            </tr>
                            <tr>
                                <th>Budget</th>
                                <td>@(item.BudgetMin?.ToString("N2")) € - @(item.BudgetMax?.ToString("N2")) €</td>
                            </tr>
                            <tr>
                                <th>Wunschtermin</th>
                                <td>@(item.PreferredDateUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                            </tr>
                            <tr>
                                <th>Erstellt am</th>
                                <td>@item.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                            <tr>
                                <th>Bewerbungen</th>
                                <td>@applicationCount</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="panel auftrag-detail-data-panel">
                @if (CanApplyToListing(item) && !HasApplied(item.Id))
                {
                    <section class="listing-application listing-application--accent">
                        <h3>Für Auftrag bewerben</h3>

                        <EditForm Model="applyModel"
                                  OnValidSubmit="ApplyAsync"
                                  FormName="@GetApplyFormName(item.Id)">
                            <DataAnnotationsValidator />

                            <div class="listing-application-grid auftrag-detail-apply-grid">
                                <div class="field">
                                    <label>Preisvorschlag (€)</label>
                                    <InputNumber @bind-Value="applyModel.ProposedPrice" class="field-input" />
                                    <ValidationMessage For="() => applyModel.ProposedPrice" />
                                </div>

                                <div class="field">
                                    <label>Vergütung</label>
                                    <InputSelect @bind-Value="applyModel.CompensationType" class="field-input">
                                        @foreach (var compensationType in Enum.GetValues<CompensationType>())
                                        {
                                            <option value="@compensationType">@T.Enum(compensationType)</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="field field--full">
                                    <label>Nachricht</label>
                                    <InputTextArea @bind-Value="applyModel.Message" class="field-input field-textarea" rows="4" />
                                    <ValidationMessage For="() => applyModel.Message" />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary" disabled="@isApplying">
                                @(isApplying ? "Bewerbung wird gesendet …" : "Jetzt bewerben")
                            </button>
                        </EditForm>
                    </section>
                }
                else if (HasApplied(item.Id))
                {
                    <div class="listing-alert listing-alert-success">
                        <strong>Du hast dich bereits auf diesen Auftrag beworben.</strong>
                    </div>
                }
            </section>

            @if (!string.IsNullOrWhiteSpace(applyError))
            {
                <div class="listing-alert listing-alert-error">@applyError</div>
            }

            @if (!string.IsNullOrWhiteSpace(applySuccess))
            {
                <div class="listing-alert listing-alert-success">@applySuccess</div>
            }
        </div>
    </div>
}