@page "/auftraege/{ListingId:guid}"

<PageTitle>Auftrag Details</PageTitle>

@if (isLoading)
{
    <div class="panel">Lädt...</div>
}
else if (item is null)
{
    <div class="panel">Auftrag wurde nicht gefunden.</div>
}
else
{
    var applyModel = GetApplicationModel(item.Id);

    <div class="auftrag-detail-page">
        <section class="panel auftrag-detail-header">
            <div>
                <div class="eyebrow">Auftrag</div>
                <h1>@item.Title</h1>
            </div>

            <div class="listing-card-actions">
                <a class="btn btn-secondary" href="/auftraege">Zurück</a>
                <a class="btn btn-secondary" href="@($"/auftraege/{item.Id}/bearbeiten")">Bearbeiten</a>
                <a class="btn btn-primary" href="@($"/auftraege/{item.Id}/vergabe")">Vergabe</a>
            </div>
        </section>

        <div class="auftrag-detail-content">
            <section class="panel auftrag-detail-media-panel">
                <div class="listing-card-media">
                    @if (item.Images.Count > 0)
                    {
                        <div class="listing-card-media-inner">
                            <ImageCarousel Images="item.Images.ToList()" />
                        </div>
                    }
                    else
                    {
                        <div class="listing-card-placeholder">
                            <span>Kein Bild verfügbar</span>
                        </div>
                    }
                </div>
            </section>

            <section class="panel auftrag-detail-data-panel">
                <div class="listing-chip-row">
                    <label>Vergütung: </label><span class="badge-soft">@T.Enum(item.CompensationType)</span>
                    <label>Status: </label><span class="badge-soft">@T.Enum(item.Status)</span>
                </div>
            </section>

            <section class="panel auftrag-detail-data-panel">
                <div class="listing-card-body">
                    <table class="auftrag-detail-table">
                        <tbody>
                            <tr>
                                <th colspan="2">Worum gehts:</th>
                            </tr>
                            <tr>
                                <td colspan="2" class="left">@item.Description</td>
                            </tr>
                            <tr>
                                <th>Kategorie</th>
                                <td>@item.Category.Name</td>
                            </tr>
                            <tr>
                                <th>Erstellt von</th>
                                <td>@item.Requester.DisplayName</td>
                            </tr>
                            <tr>
                                <th>Ort</th>
                                <td>@item.PostalCode @item.City</td>
                            </tr>
                            <tr>
                                <th>Koordinaten</th>
                                <td>@item.Latitude, @item.Longitude</td>
                            </tr>
                            <tr>
                                <th>Vergütung</th>
                                <td>@T.Enum(item.CompensationType)</td>
                            </tr>
                            <tr>
                                <th>Status</th>
                                <td>@T.Enum(item.Status)</td>
                            </tr>
                            <tr>
                                <th>Budget</th>
                                <td>@(item.BudgetMin?.ToString("N2")) € - @(item.BudgetMax?.ToString("N2")) €</td>
                            </tr>
                            <tr>
                                <th>Wunschtermin</th>
                                <td>@(item.PreferredDateUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                            </tr>
                            <tr>
                                <th>Erstellt am</th>
                                <td>@item.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                            <tr>
                                <th>Bewerbungen</th>
                                <td>@applicationCount</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="panel auftrag-detail-data-panel">
                @if (CanApplyToListing(item) && !HasApplied(item.Id))
                {
                    <section class="listing-application listing-application--accent">
                        <h3>Für Auftrag bewerben</h3>

                        <EditForm Model="applyModel"
                                  OnValidSubmit="ApplyAsync"
                                  FormName="@GetApplyFormName(item.Id)">
                            <DataAnnotationsValidator />

                            <div class="listing-application-grid auftrag-detail-apply-grid">
                                <div class="field">
                                    <label>Preisvorschlag (€)</label>
                                    <InputNumber @bind-Value="applyModel.ProposedPrice" class="field-input" />
                                    <ValidationMessage For="() => applyModel.ProposedPrice" />
                                </div>

                                <div class="field">
                                    <label>Vergütung</label>
                                    <InputSelect @bind-Value="applyModel.CompensationType" class="field-input">
                                        @foreach (var compensationType in Enum.GetValues<CompensationType>())
                                        {
                                            <option value="@compensationType">@T.Enum(compensationType)</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="field field--full">
                                    <label>Nachricht</label>
                                    <InputTextArea @bind-Value="applyModel.Message" class="field-input field-textarea" rows="4" />
                                    <ValidationMessage For="() => applyModel.Message" />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary" disabled="@isApplying">
                                @(isApplying ? "Bewerbung wird gesendet …" : "Jetzt bewerben")
                            </button>
                        </EditForm>
                    </section>
                }
                else if (HasApplied(item.Id) && !canReviewHelper)
                {
                    <div class="listing-alert listing-alert-success">
                        <strong>Du hast dich bereits auf diesen Auftrag beworben.</strong>
                    </div>
                }
            </section>

            @if (!string.IsNullOrWhiteSpace(applyError))
            {
                <div class="listing-alert listing-alert-error">@applyError</div>
            }

            @if (!string.IsNullOrWhiteSpace(applySuccess))
            {
                <div class="listing-alert listing-alert-success">@applySuccess</div>
            }

            @if (!string.IsNullOrWhiteSpace(reviewError))
            {
                <div class="listing-alert listing-alert-error">@reviewError</div>
            }

            @if (!string.IsNullOrWhiteSpace(reviewSuccess))
            {
                <div class="listing-alert listing-alert-success">@reviewSuccess</div>
            }

            @if (!string.IsNullOrWhiteSpace(chatError))
            {
                <div class="listing-alert listing-alert-error">@chatError</div>
            }

            @if (canUseChat && conversationId.HasValue)
            {
                <section class="panel auftrag-detail-data-panel chat-panel">
                    <div class="chat-panel-header">
                        <div>
                            <h3>Chat zum Auftrag</h3>
                            <p>Direkter Austausch mit @chatParticipantName</p>
                        </div>
                        <span class="badge-soft">@chatMessages.Count Nachricht@(chatMessages.Count == 1 ? string.Empty : "en")</span>
                    </div>

                    <div class="chat-thread" aria-live="polite">
                        @if (chatMessages.Count == 0)
                        {
                            <div class="chat-empty-state">Noch keine Nachrichten vorhanden.</div>
                        }
                        else
                        {
                            @foreach (var message in chatMessages)
                            {
                                var isOwnMessage = IsOwnMessage(message);

                                <article class="chat-message @(isOwnMessage ? "chat-message--own" : "chat-message--other")">
                                    <div class="chat-message-meta">
                                        <span class="chat-message-author">@message.SenderDisplayName</span>
                                        <time datetime="@message.SentUtc.ToString("O")">@message.SentUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</time>
                                    </div>

                                    <div class="chat-message-bubble">@message.Content</div>

                                    @if (isOwnMessage)
                                    {
                                        <div class="chat-message-state">@GetMessageStateText(message)</div>
                                    }
                                </article>
                            }
                        }
                    </div>

                    <EditForm Model="chatInput"
                              OnValidSubmit="SendChatMessageAsync"
                              FormName="@GetChatFormName(conversationId.Value)">
                        <DataAnnotationsValidator />

                        <div class="chat-composer">
                            <div class="field field--full">
                                <label>Neue Nachricht</label>
                                <InputTextArea @bind-Value="chatInput.Message" class="field-input field-textarea chat-composer-input" rows="3" />
                                <ValidationMessage For="() => chatInput.Message" />
                            </div>

                            <div class="chat-composer-actions">
                                <button type="submit" class="btn btn-primary" disabled="@isSendingChatMessage">
                                    @(isSendingChatMessage ? "Nachricht wird gesendet …" : "Nachricht senden")
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </section>
            }

            @if (requesterCompletionBlockedByPreferredDate)
            {
                <div class="listing-alert listing-alert-error">
                    Der Auftrag kann erst ab dem Wunschtermin (@(item?.PreferredDateUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")) beendet und bewertet werden.
                </div>
            }

            @if (canRequesterCompleteAndReview)
            {
                <ReviewCard Title="Auftrag beenden und Helfer bewerten"
                            Categories="_helperReviewCategories"
                            SubmitText="Auftrag beenden & Helfer bewerten"
                            OnSubmit="SubmitHelperReviewAsync" />
            }
            else if (canReviewHelper && !hasReviewedHelper)
            {
                <ReviewCard Title="Bewertung des Helfers durch den Auftraggeber"
                            Categories="_helperReviewCategories"
                            SubmitText="Helfer bewerten"
                            OnSubmit="SubmitHelperReviewAsync" />
            }
            else if (canReviewHelper && hasReviewedHelper)
            {
                <div class="listing-alert listing-alert-success">Du hast den Helfer bereits bewertet.</div>
            }

            @if (canReviewRequester && !hasReviewedRequester)
            {
                <ReviewCard Title="Bewertung des Auftraggebers durch den Helfer"
                            Categories="_requesterReviewCategories"
                            SubmitText="Auftraggeber bewerten"
                            OnSubmit="SubmitRequesterReviewAsync" />
            }
            else if (canReviewRequester && hasReviewedRequester)
            {
                <div class="listing-alert listing-alert-success">Du hast den Auftraggeber bereits bewertet.</div>
            }

            @if (helperReviewFromRequester is not null || requesterReviewFromHelper is not null)
            {
                <section class="panel auftrag-detail-data-panel">
                    <h3>Abgegebene Bewertungen</h3>

                    @if (helperReviewFromRequester is not null)
                    {
                        <article class="review-summary-card">
                            <h4>@helperReviewFromRequester.ReviewerRole → @helperReviewFromRequester.RevieweeRole</h4>
                            <p class="review-summary-stars">@ToStars(helperReviewFromRequester.Stars)</p>
                            <p class="review-summary-date">@helperReviewFromRequester.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>

                            <ul class="review-summary-list">
                                @foreach (var c in helperReviewFromRequester.Categories)
                                {
                                    <li><strong>@c.Label:</strong> @ToStars(c.Stars)</li>
                                }
                            </ul>
                        </article>
                    }

                    @if (requesterReviewFromHelper is not null)
                    {
                        <article class="review-summary-card">
                            <h4>@requesterReviewFromHelper.ReviewerRole → @requesterReviewFromHelper.RevieweeRole</h4>
                            <p class="review-summary-stars">@ToStars(requesterReviewFromHelper.Stars)</p>
                            <p class="review-summary-date">@requesterReviewFromHelper.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>

                            <ul class="review-summary-list">
                                @foreach (var c in requesterReviewFromHelper.Categories)
                                {
                                    <li><strong>@c.Label:</strong> @ToStars(c.Stars)</li>
                                }
                            </ul>
                        </article>
                    }
                </section>
            }
        </div>
    </div>
}
