@page "/moderation"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = PlatformRoles.Admin)]

<PageTitle>Moderation</PageTitle>
<section class="editor-header moderation-header"><div><div class="eyebrow">Geschützter Bereich</div><h2>Moderation</h2><p class="muted">Gemeldete Aufträge und Personen prüfen.</p></div><a class="btn btn-secondary" href="/admin">Zur Administration</a></section>
@if (!string.IsNullOrWhiteSpace(message)) { <div class="listing-alert @(isError ? "listing-alert-error" : "listing-alert-success")">@message</div> }

<section class="panel moderation-section">
    <div class="moderation-section-heading"><div><div class="eyebrow">Aufträge</div><h3>Gemeldete Aufträge (@FilteredListingReports.Count())</h3></div><div class="moderation-filters"><div class="field"><label for="listing-search">Suchen</label><InputText id="listing-search" class="field-input" @bind-Value="listingSearch" @bind-Value:event="oninput" placeholder="Titel, Auftraggeber oder Ort" /></div><div class="field"><label for="listing-reason-filter">Grund</label><InputSelect id="listing-reason-filter" @bind-Value="selectedListingReason" class="field-input"><option value="">Alle Gründe</option>@foreach (var reason in ReportReasons.Listing) { <option value="@reason">@reason</option> }</InputSelect></div></div></div>
    @if (!FilteredListingReports.Any()) { <p class="muted">Keine passenden offenen Auftragsmeldungen.</p> }
    <div class="moderation-grid">@foreach (var row in FilteredListingReports) { <article class="moderation-card"><div class="moderation-card-heading"><div><span class="moderation-category">@row.Report.Reason</span><h4>@(row.Listing?.Title ?? "Gelöschter Auftrag")</h4></div><small>@row.Report.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small></div>@if (row.Listing is not null) { <p class="moderation-description">@row.Listing.Description</p><dl class="moderation-facts"><div><dt>Auftraggeber</dt><dd>@row.Listing.Requester.DisplayName</dd></div><div><dt>Ort</dt><dd>@row.Listing.PostalCode @row.Listing.City</dd></div><div><dt>Status</dt><dd>@row.Listing.Status</dd></div></dl> }@if (!string.IsNullOrWhiteSpace(row.Report.Details)) { <p><strong>Zusatzangabe:</strong> @row.Report.Details</p> }<p class="muted">Gemeldet von @row.Report.ReporterUser.DisplayName</p><div class="button-group">@if (row.Listing is not null) { <a class="btn btn-primary" href="@($"/auftraege/{row.Listing.Id}")">Auftrag öffnen</a><a class="btn btn-secondary" href="@($"/auftraege/{row.Listing.Id}/bearbeiten")">Bearbeiten</a><button type="button" class="btn btn-danger" @onclick="() => row.ShowDeleteForm = !row.ShowDeleteForm">Löschen</button> }<button type="button" class="btn btn-secondary" @onclick="() => ResolveReportAsync(row.Report)">Als erledigt markieren</button></div>@if (row.ShowDeleteForm) { <div class="delete-reason-form"><div class="field"><label>Begründung an den Auftraggeber</label><InputTextArea @bind-Value="row.DeleteReason" class="field-input field-textarea" maxlength="2000" /></div><button type="button" class="btn btn-danger" @onclick="() => DeleteListingAsync(row)">Auftrag entfernen</button></div> }</article> }</div>
</section>

<section class="panel moderation-section">
    <div class="moderation-section-heading"><div><div class="eyebrow">Personen</div><h3>Gemeldete Nutzer (@FilteredUserReports.Count())</h3></div><div class="moderation-filters"><div class="field"><label for="user-report-search">Suchen</label><InputText id="user-report-search" class="field-input" @bind-Value="userSearch" @bind-Value:event="oninput" placeholder="Voller Name oder Nutzername" /></div><div class="field"><label for="user-reason-filter">Grund</label><InputSelect id="user-reason-filter" @bind-Value="selectedUserReason" class="field-input"><option value="">Alle Gründe</option>@foreach (var reason in ReportReasons.User) { <option value="@reason">@reason</option> }</InputSelect></div></div></div>
    @if (!FilteredUserReports.Any()) { <p class="muted">Keine passenden offenen Nutzermeldungen.</p> }
    <div class="moderation-grid">@foreach (var row in FilteredUserReports) { <article class="moderation-card"><div class="moderation-card-heading"><div><span class="moderation-category">@row.Report.Reason</span><h4>@(row.User?.DisplayName ?? "Gelöschter Nutzer")</h4></div><small>@row.Report.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small></div>@if (row.User is not null) { <div class="moderation-user-info"><ProfileAvatar UserId="row.User.Id" DisplayName="@row.User.DisplayName" HasImage="row.User.ProfileImageUpdatedUtc.HasValue" ImageVersion="row.User.ProfileImageUpdatedUtc?.Ticks ?? 0" /><span><strong>@row.User.DisplayName</strong><small>@@@row.User.Username</small></span></div> }@if (!string.IsNullOrWhiteSpace(row.Report.Details)) { <p><strong>Zusatzangabe:</strong> @row.Report.Details</p> }<p class="muted">Gemeldet von @row.Report.ReporterUser.DisplayName</p><div class="button-group">@if (row.User is not null) { <a class="btn btn-primary" href="@($"/profil/{row.User.Username}")">Profil öffnen</a> }<button type="button" class="btn btn-secondary" @onclick="() => ResolveReportAsync(row.Report)">Als erledigt markieren</button></div></article> }</div>
</section>
