@page "/auftraege"


<PageTitle>@T["Listings.PageTitle"]</PageTitle>

<div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;">
    <h1>@T["Listings.Headline"]</h1>
    <a href="/auftraege/neu">@T["Listings.New"]</a>
</div>

<form method="get" action="/auftraege" style="margin:1rem 0;display:grid;gap:.75rem;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));">
    <div>
        <label for="radiusKm">Radius (km): @((RadiusKm ?? EffectiveRadiusKm).ToString("N0"))</label>
        <input id="radiusKm"
               name="radiusKm"
               type="range"
               min="1"
               max="200"
               step="1"
               value="@(RadiusKm ?? EffectiveRadiusKm)" />
    </div>
    <div style="display:flex;gap:.5rem;align-items:end;">
        <button type="submit" class="btn btn-primary">Search radius</button>
        <a href="/auftraege">Reset</a>
    </div>
</form>

@if (IsGeoSearchActive)
{
    <p><strong>Geo filter active:</strong> @Latitude, @Longitude, @EffectiveRadiusKm km</p>
}

@if (!string.IsNullOrWhiteSpace(applyError))
{
    <div class="alert-error">@applyError</div>
}
@if (!string.IsNullOrWhiteSpace(applySuccess))
{
    <div style="margin:1rem 0;padding:.75rem;border:1px solid #b7eb8f;background:#f6ffed;border-radius:8px;">
        @applySuccess
    </div>
}

@if (items is null)
{
    <p>@T["General.Loading"]</p>
}
else if (items.Count == 0)
{
    <p>@T["Listings.Empty"]</p>
}
else
{
    <div style="display:grid;gap:1rem;">
        @foreach (var item in items)
        {
            var applyModel = GetApplicationModel(item.Id);

            <article style="border:1px solid #ddd;padding:1rem;border-radius:8px;">
                <div style="display:flex;justify-content:space-between;align-items:start;gap:1rem;flex-wrap:wrap;">
                    <h2>@item.Title</h2>
                    <div style="display:flex;gap:.75rem;">
                        <a href="@($"/auftraege/{item.Id}/bearbeiten")">@T["General.Edit"]</a>
                        <a href="@($"/auftraege/{item.Id}/vergabe")">Vergabe</a>
                    </div>
                </div>

                @if (item.Images.Count > 0)
                {
                    <div style="margin:.75rem 0;">
                        <ImageCarousel Images="item.Images.ToList()" />
                    </div>
                }

                <p>@item.Description</p>
                <p><strong>@T["Listings.Category"]:</strong> @item.Category.Name</p>
                <p><strong>@T["Listings.Requester"]:</strong> @item.Requester.DisplayName</p>
                <p><strong>@T["Listings.Location"]:</strong> @item.PostalCode @item.City</p>
                <p><strong>Coordinates:</strong> @item.Latitude, @item.Longitude</p>

                @if (IsGeoSearchActive)
                {
                    <p><strong>Distance:</strong> @GetDistanceText(item.Id)</p>
                }

                <p><strong>@T["Listings.Compensation"]:</strong> @T.Enum(item.CompensationType)</p>
                <p><strong>@T["Listings.Status"]:</strong> @T.Enum(item.Status)</p>
                <p><strong>@T["Listings.Budget"]:</strong> @(item.BudgetMin?.ToString("N2")) € - @(item.BudgetMax?.ToString("N2")) €</p>

                @if (CanApplyToListing(item) && !HasApplied(item.Id))
                {
                    <section style="margin-top:1rem;border-top:1px solid #eee;padding-top:1rem;">
                        <h3 style="margin-top:0;">Für Auftrag bewerben</h3>

                        <EditForm Model="applyModel"
                                  OnValidSubmit="() => ApplyAsync(item.Id)"
                                  FormName="@GetApplyFormName(item.Id)">
                            <DataAnnotationsValidator />

                            <div style="display:grid;gap:.75rem;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
                                <div>
                                    <label>Preisvorschlag (€)</label>
                                    <InputNumber @bind-Value="applyModel.ProposedPrice" class="field-input" />
                                    <ValidationMessage For="() => applyModel.ProposedPrice" />
                                </div>

                                <div>
                                    <label>Vergütung</label>
                                    <InputSelect @bind-Value="applyModel.CompensationType" class="field-input">
                                        @foreach (var compensationType in Enum.GetValues<CompensationType>())
                                        {
                                            <option value="@compensationType">@T.Enum(compensationType)</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div style="grid-column:1 / -1;">
                                    <label>Nachricht</label>
                                    <InputTextArea @bind-Value="applyModel.Message" class="field-input" rows="4" />
                                    <ValidationMessage For="() => applyModel.Message" />
                                </div>
                            </div>

                            <button type="submit"
                                    class="btn btn-primary"
                                    disabled="@(applyingListingId == item.Id)">
                                @(applyingListingId == item.Id ? "Bewerbung wird gesendet …" : "Jetzt bewerben")
                            </button>
                        </EditForm>
                    </section>
                }
                else if (HasApplied(item.Id))
                {
                    <p style="margin-top:1rem;color:#237804;"><strong>Du hast dich bereits auf diesen Auftrag beworben.</strong></p>
                }
            </article>
        }
    </div>
}