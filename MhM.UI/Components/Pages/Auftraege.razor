@page "/auftraege"
@using Microsoft.EntityFrameworkCore
@inject MhMDbContext Db

<PageTitle>Aufträge</PageTitle>

<div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;">
    <h1>Offene Aufträge</h1>
    <a href="/auftraege/neu">Neuen Auftrag erstellen</a>
</div>

@if (items is null)
{
    <p>Lade Daten...</p>
}
else if (items.Count == 0)
{
    <p>Keine offenen Aufträge vorhanden.</p>
}
else
{
    <div style="display:grid;gap:1rem;">
        @foreach (var item in items)
        {
            <article style="border:1px solid #ddd;padding:1rem;border-radius:8px;">
                <div style="display:flex;justify-content:space-between;align-items:start;gap:1rem;flex-wrap:wrap;">
                    <h2>@item.Title</h2>
                    <a href="@($"/auftraege/{item.Id}/bearbeiten")">Bearbeiten</a>
                </div>

                <p>@item.Description</p>
                <p><strong>Kategorie:</strong> @item.Category.Name</p>
                <p><strong>Auftraggeber:</strong> @item.Requester.DisplayName</p>
                <p><strong>Ort:</strong> @item.PostalCode @item.City</p>
                <p><strong>Vergütung:</strong> @item.CompensationType</p>
                <p><strong>Status:</strong> @item.Status</p>
                <p><strong>Budget:</strong> @(item.BudgetMin?.ToString("0.00")) € - @(item.BudgetMax?.ToString("0.00")) €</p>
            </article>
        }
    </div>
}

@code {
    private List<Listing>? items;

    protected override async Task OnInitializedAsync()
    {
        items = await Db.Listings
            .Include(x => x.Category)
            .Include(x => x.Requester)
            .Where(x => x.Status == ListingStatus.Offen)
            .OrderByDescending(x => x.CreatedUtc)
            .ToListAsync();
    }
}