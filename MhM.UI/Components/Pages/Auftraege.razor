@page "/auftraege"

<PageTitle>@T["Listings.PageTitle"]</PageTitle>

<div class="auftraege-page">
    <section class="panel auftraege-header">
        <div>
            <div class="eyebrow">@T["Listings.PageTitle"]</div>
            <h1>@T["Listings.Headline"]</h1>
        </div>

        <a class="btn btn-primary" href="/auftraege/neu">@T["Listings.New"]</a>
    </section>

    <div class="auftraege-layout">
        <aside class="panel auftraege-sidebar">
            <form method="get" action="/auftraege" class="auftraege-filter-form">
                <div class="field">
                    <label for="q">Suchbegriff</label>
                    <input id="q" name="q" value="@Query" class="field-input" placeholder="Titel oder Beschreibung" />
                </div>

                <div class="field">
                    <label for="city">Ort / PLZ</label>
                    <input id="city" name="city" value="@City" class="field-input" placeholder="z.B. Würzburg oder 97070" />
                </div>

                <div class="field">
                    <label for="comp">Vergütung</label>
                    <select id="comp" name="comp" class="field-input">
                        <option value="">Alle</option>
                        @foreach (var compensationType in Enum.GetValues<CompensationType>())
                        {
                            <option value="@((int)compensationType)" selected="@(CompensationFilter == compensationType)">
                                @T.Enum(compensationType)
                            </option>
                        }
                    </select>
                </div>

                <div class="field budget-fields">
                    <div>
                        <label for="min">Budget min (€)</label>
                        <input id="min" name="min" type="number" step="1" value="@BudgetMinFilter" class="field-input" />
                    </div>
                    <div>
                        <label for="max">Budget max (€)</label>
                        <input id="max" name="max" type="number" step="1" value="@BudgetMaxFilter" class="field-input" />
                    </div>
                </div>

                <div class="field">
                    <label for="radiusKm">Radius (km): @((RadiusKm ?? EffectiveRadiusKm).ToString("N0"))</label>
                    <input id="radiusKm"
                           name="radiusKm"
                           type="range"
                           min="1"
                           max="200"
                           step="1"
                           value="@(RadiusKm ?? EffectiveRadiusKm)"
                           class="listing-range" />
                </div>

                <div class="field">
                    <label>Kategorien</label>
                    <div class="category-checklist">
                        @foreach (var category in categories)
                        {
                            var isChecked = selectedCategoryIds.Contains(category.Id);
                            <label class="category-check-item">
                                <input type="checkbox" name="k" value="@category.Id" checked="@isChecked" />
                                <span>@category.Name</span>
                            </label>
                        }
                    </div>
                </div>

                <div class="listing-filter-actions">
                    <button type="submit" class="btn btn-primary">Suchen</button>
                    <a class="btn btn-secondary" href="/auftraege">Reset</a>
                </div>
            </form>
        </aside>

        <section class="auftraege-results">
            @*Todo: Ggf entfernen*@
            @if (false && IsGeoSearchActive)
            {
                <div class="listing-alert listing-alert-info">
                    <strong>Geo filter active:</strong> @Latitude, @Longitude, @EffectiveRadiusKm km
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(applyError))
            {
                <div class="listing-alert listing-alert-error">@applyError</div>
            }

            @if (!string.IsNullOrWhiteSpace(applySuccess))
            {
                <div class="listing-alert listing-alert-success">@applySuccess</div>
            }

            @if (items is null)
            {
                <div class="panel">@T["General.Loading"]</div>
            }
            else if (items.Count == 0)
            {
                <div class="panel">@T["Listings.Empty"]</div>
            }
            else
            {
                <div class="listing-list">
                    <AuftraegeKarten Items="items" />
                </div>
            }
        </section>
    </div>
</div>