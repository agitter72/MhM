@page "/auftraege/{Id:guid}/vergabe"

<PageTitle>Vergabe</PageTitle>

@if (isLoading)
{
    <p>Lade Vergabevorschläge …</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert-error">@error</div>
}
else
{
    <div class="assignment-header">
        <div>
            <h1>Vergabe: @listingTitle</h1>
            <p><strong>Status:</strong> @listingStatusText</p>
        </div>
        <a href="/auftraege/@Id">Zurück</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(success))
    {
        <div class="assignment-success">
            @success
        </div>
    }

    @if (applicationRows.Count == 0)
    {
        <p>Keine Bewerbungen vorhanden.</p>
    }
    else
    {
        <div class="assignment-filter-bar">
            <button class="btn btn-secondary @(selectedStatusFilter is null ? "is-active" : null)"
                    @onclick="() => SetFilter(null)">
                Alle (@CountAll)
            </button>

            <button class="btn btn-secondary @(selectedStatusFilter == ListingApplicationStatus.Eingereicht ? "is-active" : null)"
                    @onclick="() => SetFilter(ListingApplicationStatus.Eingereicht)">
                Eingereicht (@CountEingereicht)
            </button>

            <button class="btn btn-secondary @(selectedStatusFilter == ListingApplicationStatus.Angenommen ? "is-active" : null)"
                    @onclick="() => SetFilter(ListingApplicationStatus.Angenommen)">
                Angenommen (@CountAngenommen)
            </button>

            <button class="btn btn-secondary @(selectedStatusFilter == ListingApplicationStatus.Abgelehnt ? "is-active" : null)"
                    @onclick="() => SetFilter(ListingApplicationStatus.Abgelehnt)">
                Abgelehnt (@CountAbgelehnt)
            </button>
        </div>

        <div class="assignment-legend">
            <span class="assignment-legend-item">
                <span class="assignment-legend-dot status-dot-eingereicht"></span>
                Eingereicht
            </span>
            <span class="assignment-legend-item">
                <span class="assignment-legend-dot status-dot-angenommen"></span>
                Angenommen
            </span>
            <span class="assignment-legend-item">
                <span class="assignment-legend-dot status-dot-abgelehnt"></span>
                Abgelehnt
            </span>
        </div>

        @if (FilteredApplicationRows.Count == 0)
        {
            <p>Keine Bewerbungen im gewählten Filter.</p>
        }
        else
        {
            <table class="assignment-table assignment-table-compact">
                <thead>
                    <tr>
                        <th>Helfer</th>
                        <th>Status</th>
                        <th>Gesamtscore</th>
                        <th>Distanz</th>
                        <th>Preis</th>
                        <th>Details</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in FilteredApplicationRows)
                    {
                        <tr>
                            <td data-label="Helfer">@row.ApplicantName</td>
                            <td data-label="Status">
                                <span class="@GetStatusBadgeClass(row.Status)">
                                    @GetStatusText(row.Status)
                                </span>
                            </td>
                            <td data-label="Gesamtscore">@(row.TotalScore?.ToString("N1") ?? "—")</td>
                            <td data-label="Distanz">@(row.DistanceKm?.ToString("N1") + " km" ?? "n/a")</td>
                            <td data-label="Preis">@(row.ProposedPrice?.ToString("N2") + " €" ?? "n/a")</td>
                            <td data-label="Details">
                                @if (row.TotalScore.HasValue)
                                {
                                    <span>
                                        D:@(row.DistanceScore?.ToString("N0") ?? "—")
                                        | B:@(row.RatingScore?.ToString("N0") ?? "—")
                                        | P:@(row.PriceScore?.ToString("N0") ?? "—")
                                        | Z:@(row.ReliabilityScore?.ToString("N0") ?? "—")
                                        | V:@(row.VerificationScore?.ToString("N0") ?? "—")
                                    </span>
                                }
                                else
                                {
                                    <span>Kein aktuelles Ranking</span>
                                }
                            </td>
                            <td data-label="" class="assignment-cell-actions">
                                <button class="btn btn-primary assignment-assign-btn"
                                        disabled="@(isAssigning || !canAssign || row.Status != ListingApplicationStatus.Eingereicht)"
                                        @onclick="() => AssignAsync(row.ApplicantId)">
                                    Vergeben
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}