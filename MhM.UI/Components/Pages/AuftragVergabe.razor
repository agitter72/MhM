@page "/auftraege/{Id:guid}/vergabe"

<PageTitle>Vergabe</PageTitle>

@if (isLoading)
{
    <p>Lade Vergabevorschläge …</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert-error">@error</div>
}
else
{
    <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;">
        <div>
            <h1>Vergabe: @listingTitle</h1>
            <p><strong>Status:</strong> @listingStatusText</p>
        </div>
        <a href="/auftraege">Zurück zur Liste</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(success))
    {
        <div style="margin:1rem 0;padding:.75rem;border:1px solid #b7eb8f;background:#f6ffed;border-radius:8px;">
            @success
        </div>
    }

    @if (candidates.Count == 0)
    {
        <p>Keine passenden Bewerbungen gefunden.</p>
    }
    else
    {
        <table style="width:100%;border-collapse:collapse;margin-top:1rem;">
            <thead>
                <tr>
                    <th style="text-align:left;padding:.5rem;border-bottom:1px solid #ddd;">Helfer</th>
                    <th style="text-align:left;padding:.5rem;border-bottom:1px solid #ddd;">Gesamtscore</th>
                    <th style="text-align:left;padding:.5rem;border-bottom:1px solid #ddd;">Distanz</th>
                    <th style="text-align:left;padding:.5rem;border-bottom:1px solid #ddd;">Preis</th>
                    <th style="text-align:left;padding:.5rem;border-bottom:1px solid #ddd;">Details</th>
                    <th style="text-align:left;padding:.5rem;border-bottom:1px solid #ddd;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in candidates)
                {
                    <tr>
                        <td style="padding:.5rem;border-bottom:1px solid #eee;">@c.ApplicantName</td>
                        <td style="padding:.5rem;border-bottom:1px solid #eee;"><strong>@c.TotalScore.ToString("N1")</strong></td>
                        <td style="padding:.5rem;border-bottom:1px solid #eee;">@(c.DistanceKm?.ToString("N1") + " km" ?? "n/a")</td>
                        <td style="padding:.5rem;border-bottom:1px solid #eee;">@(c.ProposedPrice?.ToString("N2") + " €" ?? "n/a")</td>
                        <td style="padding:.5rem;border-bottom:1px solid #eee;">
                            D:@c.DistanceScore.ToString("N0")
                            | B:@c.RatingScore.ToString("N0")
                            | P:@c.PriceScore.ToString("N0")
                            | Z:@c.ReliabilityScore.ToString("N0")
                            | V:@c.VerificationScore.ToString("N0")
                        </td>
                        <td style="padding:.5rem;border-bottom:1px solid #eee;">
                            <button class="btn btn-primary"
                                    disabled="@(isAssigning || !canAssign)"
                                    @onclick="() => AssignAsync(c.ApplicantId)">
                                Vergeben
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}