@page "/helfer"
<PageTitle>@T["Helpers.PageTitle"]</PageTitle>

<section class="helpers-heading"><div><div class="eyebrow">Helfer finden</div><h1>@T["Helpers.Headline"]</h1></div><div class="field helper-search"><label for="helper-search">Helfer suchen</label><div><Icon CustomIconName="bi bi-search" /><input id="helper-search" class="field-input" value="@search" @oninput="FilterHelpers" placeholder="Name, Nutzername, Skills oder Ort" /></div></div></section>

@if (items is null) { <LoadingSkeleton Variant="helpers" /> }
else
{
    @if (currentUser is not null)
    {
        <section class="panel current-helper-overview">
            <div class="current-helper-heading"><ProfileAvatar UserId="currentUser.Id" DisplayName="@currentUser.DisplayName" HasImage="currentUser.ProfileImageUpdatedUtc.HasValue" ImageVersion="currentUser.ProfileImageUpdatedUtc?.Ticks ?? 0" CssClass="helper-overview-avatar" /><div><div class="eyebrow">Dein Helferprofil</div><h2>@currentUser.DisplayName</h2><a href="@($"/profil/{currentUser.Username}")">@@@currentUser.Username</a></div><a class="btn btn-secondary" href="/einstellungen?tab=helper-profile">In den Profileinstellungen bearbeiten</a></div>
            @if (currentUser.Role != UserRole.Helfer) { <p class="muted">Dein Helferprofil ist aktuell deaktiviert. Du kannst es in den Profileinstellungen aktivieren.</p> }
            else if (currentHelperProfile is not null) { <p class="helper-card-description">@(string.IsNullOrWhiteSpace(currentUser.Description) ? "Noch keine Profilbeschreibung." : currentUser.Description)</p><dl class="helper-facts"><div><dt><Icon CustomIconName="bi bi-cash-coin" /> Stundensatz</dt><dd>@(currentHelperProfile.HourlyRate?.ToString("N2") ?? "Nach Absprache")@(currentHelperProfile.HourlyRate.HasValue ? " â¬" : null)</dd></div><div><dt><Icon CustomIconName="bi bi-geo-alt" /> Einsatzradius</dt><dd>@currentHelperProfile.RadiusKm km</dd></div><div><dt><Icon CustomIconName="bi bi-arrow-left-right" /> Tausch</dt><dd>@(currentHelperProfile.OffersBarter ? "MÃ¶glich" : "Nicht angeboten")</dd></div><div><dt><Icon CustomIconName="bi bi-tools" /> Skills</dt><dd>@(string.IsNullOrWhiteSpace(currentHelperProfile.Skills) ? "Keine angegeben" : currentHelperProfile.Skills)</dd></div></dl> }
        </section>
    }

    <div class="helpers-result-summary">@VisibleItems.Count von @FilteredCount Helfern angezeigt</div>
    @if (VisibleItems.Count == 0) { <div class="panel"><p class="muted">Keine passenden Helfer gefunden.</p></div> }
    else
    {
        <div class="helpers-list">
            @foreach (var item in VisibleItems)
            {
                var user = item.User;
                var stats = GetStats(item.UserId);
                var skills = GetSkills(item);
                <article class="panel helper-card">
                    <div class="helper-card-heading">
                        <span class="helper-card-icon" aria-hidden="true"><Icon CustomIconName="bi bi-tools" /></span>
                        <a class="helper-card-identity" href="@($"/profil/{user.Username}")"><span class="eyebrow">Helferprofil</span><h2>@user.DisplayName</h2></a>
                        <span class="helper-rating" title="@stats.ReviewCount Bewertung@(stats.ReviewCount == 1 ? string.Empty : "en")">
                            <Icon CustomIconName="bi bi-star-fill" />
                            <strong>@(stats.Rating?.ToString("0.0") ?? "Neu")</strong>
                            @if (stats.ReviewCount > 0) { <span>(@stats.ReviewCount)</span> }
                        </span>
                    </div>
                    <p class="helper-card-description">@(string.IsNullOrWhiteSpace(user.Description) ? "Noch keine Profilbeschreibung." : user.Description)</p>
                    @if (skills.Count > 0)
                    {
                        <div class="helper-skill-list" aria-label="Fähigkeiten">@foreach (var skill in skills) { <span>@skill</span> }</div>
                    }
                    <dl class="helper-facts">
                        <div><dt><Icon CustomIconName="bi bi-cash-coin" /> Stundensatz</dt><dd>@(item.HourlyRate?.ToString("N2") ?? "Nach Absprache")@(item.HourlyRate.HasValue ? " €" : null)</dd></div>
                        <div><dt><Icon CustomIconName="bi bi-geo-alt" /> Einsatzradius</dt><dd>@item.RadiusKm km</dd></div>
                        <div><dt><Icon CustomIconName="bi bi-arrow-left-right" /> Tausch</dt><dd>@(item.OffersBarter ? "Möglich" : "Nicht angeboten")</dd></div>
                        <div><dt><Icon CustomIconName="bi bi-check2-circle" /> Aufträge</dt><dd>@stats.AcceptedCount angenommen</dd></div>
                    </dl>
                </article>
            }
        </div>
    }
    @if (HasMoreItems) { <div class="infinite-scroll-sentinel" @ref="loadMoreSentinel"><span class="visually-hidden">Weitere Helfer werden geladen</span><div class="loading-more-skeleton"><span></span><span></span><span></span></div></div> }
}
