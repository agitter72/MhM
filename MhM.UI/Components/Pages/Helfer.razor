@page "/helfer"
@using Microsoft.EntityFrameworkCore
@inject MhMDbContext Db

<PageTitle>Helfer</PageTitle>

<h1>Helfer in der Region</h1>

@if (items is null)
{
    <p>Lade Daten...</p>
}
else if (items.Count == 0)
{
    <p>Keine Helferprofile vorhanden.</p>
}
else
{
    <div style="display:grid;gap:1rem;">
        @foreach (var item in items)
        {
            <article style="border:1px solid #ddd;padding:1rem;border-radius:8px;">
                <h2>@item.Title</h2>
                <p><strong>Name:</strong> @item.User.DisplayName</p>
                <p>@item.Description</p>
                <p><strong>Skills:</strong> @item.Skills</p>
                <p><strong>Radius:</strong> @item.RadiusKm km</p>
                <p><strong>Stundensatz:</strong> @(item.HourlyRate?.ToString("0.00")) €</p>
                <p><strong>Tausch möglich:</strong> @(item.OffersBarter ? "Ja" : "Nein")</p>
            </article>
        }
    </div>
}

@code {
    private List<HelperProfile>? items;

    protected override async Task OnInitializedAsync()
    {
        items = await Db.HelperProfiles
            .Include(x => x.User)
            .OrderBy(x => x.User.City)
            .ThenBy(x => x.User.DisplayName)
            .ToListAsync();
    }
}