@page "/admin"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = PlatformRoles.Admin)]

<PageTitle>Administration</PageTitle>

<section class="editor-header admin-header">
    <div><div class="eyebrow">Geschützter Bereich</div><h2>Administration</h2><p class="muted">Nutzer, Rollen und Sperren verwalten. Jede Änderung wird protokolliert.</p></div>
    <a class="btn btn-secondary" href="/moderation"><Icon CustomIconName="bi bi-flag" /> Moderation öffnen</a>
</section>

@if (!string.IsNullOrWhiteSpace(message)) { <div class="listing-alert @(isError ? "listing-alert-error" : "listing-alert-success")" role="status">@message</div> }

<section class="panel admin-section">
    <div class="admin-section-heading">
        <div><div class="eyebrow">Verwaltung</div><h3>Nutzer (@FilteredUserCount)</h3></div>
        <div class="field admin-filter"><label for="admin-user-search">Nutzer suchen</label><div class="admin-search-wrap"><Icon CustomIconName="bi bi-search" /><input id="admin-user-search" class="field-input" value="@userSearch" @oninput="FilterUsers" placeholder="Nutzername, Name, E-Mail oder Ort" /></div></div>
    </div>

    @if (VisibleUsers.Count == 0) { <p class="muted">Keine passenden Nutzer gefunden.</p> }
    <div class="admin-user-grid">
        @foreach (var row in VisibleUsers)
        {
            <article class="admin-user-card">
                <div class="admin-user-head">
                    <a class="admin-user-identity" href="@($"/profil/{row.Username}")">
                        <ProfileAvatar UserId="row.UserId" DisplayName="@row.DisplayName" HasImage="row.ProfileImageUpdatedUtc.HasValue" ImageVersion="row.ProfileImageUpdatedUtc?.Ticks ?? 0" CssClass="admin-user-avatar" />
                        <span><strong>@row.DisplayName</strong><small>@@@row.Username</small></span>
                    </a>
                    <span class="admin-status @(row.IsActive ? "is-active" : "is-blocked")">@(row.IsActive ? "Aktiv" : "Gesperrt")</span>
                </div>
                <div class="admin-user-meta"><span><Icon CustomIconName="bi bi-envelope" /> @row.Email</span><span><Icon CustomIconName="bi bi-geo-alt" /> @row.City</span></div>
                <div class="admin-user-settings">
                    <div class="field"><label for="@($"role-{row.UserId}")">Nutzerart</label><InputSelect id="@($"role-{row.UserId}")" @bind-Value="row.ProfileRole" class="field-input">@foreach (var role in Enum.GetValues<UserRole>()) { <option value="@role">@role</option> }</InputSelect></div>
                    <div class="admin-check-group"><span class="admin-setting-label">Vertrauen</span><div class="admin-check-row"><label class="admin-check"><InputCheckbox @bind-Value="row.EmailVerified" /><span>E-Mail</span></label><label class="admin-check"><InputCheckbox @bind-Value="row.PhoneVerified" /><span>Telefon</span></label><label class="admin-check"><InputCheckbox @bind-Value="row.IdentityVerified" /><span>Identität</span></label></div></div>
                    <label class="admin-check admin-check-admin"><InputCheckbox @bind-Value="row.IsAdmin" disabled="@(row.IdentityId == currentIdentityId)" /><span>Administrator</span></label>
                </div>
                <div class="admin-row-actions">
                    <button class="btn btn-primary" disabled="@(!row.IsDirty || row.IsSaving)" @onclick="() => SaveUserAsync(row)"><Icon CustomIconName="@(row.IsSaving ? "bi bi-arrow-repeat" : "bi bi-check2")" /> @(row.IsSaving ? "Speichert..." : "Speichern")</button>
                    @if (row.Saved && !row.IsDirty) { <span class="admin-saved"><Icon CustomIconName="bi bi-check-circle-fill" /> Gespeichert</span> }
                    <button class="btn btn-secondary" disabled="@(row.IdentityId == currentIdentityId)" @onclick="() => SetBanAsync(row, row.IsActive)">@(row.IsActive ? "Sperren" : "Entsperren")</button>
                    <button class="btn btn-danger" disabled="@(row.IdentityId == currentIdentityId)" @onclick="() => DeleteUserAsync(row)">Löschen</button>
                </div>
            </article>
        }
    </div>
    @if (HasMoreUsers) { <div class="infinite-scroll-sentinel" @ref="loadMoreSentinel" role="status"><span class="visually-hidden">Weitere Nutzer werden geladen</span><div class="loading-more-skeleton"><span></span><span></span><span></span></div></div> }
</section>
