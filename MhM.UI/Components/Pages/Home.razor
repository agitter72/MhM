@page "/"

<PageTitle>Menschen helfen Menschen</PageTitle>

<section class="hero-grid">
    <article class="hero-card hero-card-featured">
        <div class="eyebrow">Nachbarschaftshilfe neu gedacht</div>
        <h2>Regionale Hilfe für Alltag, Haus und Garten.</h2>
        <p>
            Menschen, Familien und Helfer werden direkt miteinander verbunden.
            Kleinaufträge, Tauschgeschäfte und bezahlte Unterstützung in einer modernen Plattform.
        </p>

        <div class="hero-actions">
            <a class="btn btn-primary" href="/auftraege/neu">Auftrag erstellen</a>
            <a class="btn btn-secondary" href="/helfer">Helfer finden</a>
        </div>

        <div class="stat-grid">
            <div class="stat-card">
                <span>Offene Aufträge</span>
                <strong>128</strong>
            </div>
            <div class="stat-card">
                <span>Aktive Helfer</span>
                <strong>64</strong>
            </div>
            <div class="stat-card">
                <span>Tauschangebote</span>
                <strong>37</strong>
            </div>
        </div>
    </article>

    <article class="hero-card hero-card-accent">
        <div class="eyebrow">Live Fokus</div>
        <h3>Top-Kategorien</h3>

        <div class="mini-list">
            <div class="mini-list-item">
                <span>Garten & Außenbereich</span>
                <strong>34</strong>
            </div>
            <div class="mini-list-item">
                <span>Computer & Technik</span>
                <strong>21</strong>
            </div>
            <div class="mini-list-item">
                <span>Haushalt & Reinigung</span>
                <strong>18</strong>
            </div>
            <div class="mini-list-item">
                <span>Seniorenhilfe</span>
                <strong>15</strong>
            </div>
        </div>
    </article>
</section>

<section class="dashboard-grid">
    <article class="panel">
        <div class="panel-header">
            <div>
                <div class="eyebrow">Core Features</div>
                <h3>Plattform-Module</h3>
            </div>
        </div>

        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-icon">👤</div>
                <h4>Profile</h4>
                <p>Registrierung für Suchende, Helfer und regionale Anbieter.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">🗂</div>
                <h4>Aufträge</h4>
                <p>Kleinaufträge einfach anlegen, verwalten und veröffentlichen.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">💬</div>
                <h4>Chat</h4>
                <p>Direkte Abstimmung für Rückfragen, Termine und Details.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">★</div>
                <h4>Bewertungen</h4>
                <p>Vertrauen durch Feedback und regionale Reputation.</p>
            </div>
        </div>
    </article>

    <article class="panel">
        <div class="panel-header">
            <div>
                <div class="eyebrow">Business Model</div>
                <h3>Erlösquellen</h3>
            </div>
        </div>

        <div class="timeline-list">
            <div class="timeline-item">
                <strong>Premiumprofile</strong>
                <span>Sichtbarkeit für Helfer und Unternehmen</span>
            </div>
            <div class="timeline-item">
                <strong>Hervorgehobene Anzeigen</strong>
                <span>Mehr Reichweite für dringende Aufträge</span>
            </div>
            <div class="timeline-item">
                <strong>Vermittlungsgebühren</strong>
                <span>Optionale Provision auf erfolgreiche Aufträge</span>
            </div>
            <div class="timeline-item">
                <strong>Verifizierungen & Werbung</strong>
                <span>Zusatzumsätze für regionale Präsenz</span>
            </div>
        </div>
    </article>
</section>
