<div class="skeleton-root skeleton-@Variant" role="status" aria-live="polite" aria-label="Inhalte werden geladen">
    <span class="visually-hidden">Inhalte werden geladen</span>

    @switch (Variant)
    {
        case "cards":
            <div class="skeleton-card-grid" aria-hidden="true">
                @for (var index = 0; index < Count; index++)
                {
                    <article class="skeleton-card">
                        <div class="skeleton-block skeleton-card-image"></div>
                        <div class="skeleton-card-body"><div class="skeleton-line skeleton-line-title"></div><div class="skeleton-line skeleton-line-short"></div><div class="skeleton-line skeleton-line-price"></div><div class="skeleton-person"><div class="skeleton-circle"></div><div class="skeleton-line"></div></div></div>
                    </article>
                }
            </div>
            break;
        case "editor":
            <div class="skeleton-page" aria-hidden="true"><div class="skeleton-heading"><div><div class="skeleton-line skeleton-line-kicker"></div><div class="skeleton-line skeleton-line-heading"></div><div class="skeleton-line skeleton-line-copy"></div></div><div class="skeleton-pills"><div></div><div></div></div></div><div class="skeleton-two-column"><section class="skeleton-panel skeleton-form"><div class="skeleton-line skeleton-line-kicker"></div><div class="skeleton-line skeleton-line-subheading"></div><div class="skeleton-fields"><div></div><div></div><div class="wide"></div><div class="wide tall"></div><div></div><div></div></div></section><aside class="skeleton-panel"><div class="skeleton-block skeleton-preview"></div><div class="skeleton-line skeleton-line-subheading"></div><div class="skeleton-line"></div><div class="skeleton-line skeleton-line-short"></div></aside></div></div>
            break;
        case "detail":
            <div class="skeleton-page" aria-hidden="true"><section class="skeleton-panel skeleton-detail-head"><div><div class="skeleton-pills"><div></div><div></div></div><div class="skeleton-line skeleton-line-heading"></div></div><div class="skeleton-button"></div></section><div class="skeleton-detail-grid"><section class="skeleton-panel"><div class="skeleton-block skeleton-detail-image"></div></section><aside><section class="skeleton-panel skeleton-person-card"><div class="skeleton-circle skeleton-avatar"></div><div><div class="skeleton-line skeleton-line-subheading"></div><div class="skeleton-line skeleton-line-short"></div></div></section><section class="skeleton-panel skeleton-facts"><div class="skeleton-line skeleton-line-subheading"></div>@for (var index = 0; index < 4; index++) { <div><span></span><span></span></div> }</section></aside></div><section class="skeleton-panel"><div class="skeleton-line skeleton-line-subheading"></div><div class="skeleton-line"></div><div class="skeleton-line"></div><div class="skeleton-line skeleton-line-copy"></div></section></div>
            break;
        case "table":
            <div class="skeleton-page" aria-hidden="true"><div class="skeleton-heading"><div><div class="skeleton-line skeleton-line-heading"></div><div class="skeleton-line skeleton-line-short"></div></div><div class="skeleton-button"></div></div><div class="skeleton-pills"><div></div><div></div><div></div><div></div></div><section class="skeleton-panel skeleton-table">@for (var index = 0; index < 5; index++) { <div class="skeleton-table-row"><span></span><span></span><span></span><span></span><span></span></div> }</section></div>
            break;
        case "helpers":
            <div class="skeleton-page" aria-hidden="true"><div class="skeleton-line skeleton-line-heading"></div><div class="skeleton-two-column"><section class="skeleton-panel skeleton-form"><div class="skeleton-line skeleton-line-subheading"></div><div class="skeleton-fields"><div class="wide"></div><div class="wide tall"></div><div class="wide"></div><div></div><div></div></div></section><aside class="skeleton-panel"><div class="skeleton-line skeleton-line-kicker"></div><div class="skeleton-line skeleton-line-subheading"></div><div class="skeleton-line"></div></aside></div><div class="skeleton-helper-grid">@for (var index = 0; index < 3; index++) { <section class="skeleton-panel"><div class="skeleton-person"><div class="skeleton-circle skeleton-avatar"></div><div><div class="skeleton-line skeleton-line-subheading"></div><div class="skeleton-line skeleton-line-short"></div></div></div><div class="skeleton-line"></div><div class="skeleton-line"></div><div class="skeleton-line skeleton-line-short"></div></section> }</div></div>
            break;
        case "profile":
            <div class="skeleton-page" aria-hidden="true"><div class="skeleton-profile-grid"><section class="skeleton-panel"><div class="skeleton-circle skeleton-profile-avatar"></div><div class="skeleton-line skeleton-line-heading"></div><div class="skeleton-line skeleton-line-short"></div><div class="skeleton-line"></div><div class="skeleton-line skeleton-line-copy"></div><div class="skeleton-pills"><div></div><div></div><div></div></div></section><section class="skeleton-panel"><div class="skeleton-person"><div class="skeleton-circle"></div><div class="skeleton-line skeleton-line-subheading"></div></div><div class="skeleton-line"></div><div class="skeleton-fields"><div></div><div></div><div></div><div></div></div></section></div><div class="skeleton-line skeleton-line-subheading"></div><div class="skeleton-card-grid"><article class="skeleton-card"><div class="skeleton-block skeleton-card-image"></div><div class="skeleton-card-body"><div class="skeleton-line skeleton-line-title"></div><div class="skeleton-line skeleton-line-short"></div></div></article><article class="skeleton-card"><div class="skeleton-block skeleton-card-image"></div><div class="skeleton-card-body"><div class="skeleton-line skeleton-line-title"></div><div class="skeleton-line skeleton-line-short"></div></div></article></div></div>
            break;
        case "settings":
            <div class="skeleton-page" aria-hidden="true"><section class="skeleton-panel skeleton-heading"><div><div class="skeleton-line skeleton-line-kicker"></div><div class="skeleton-line skeleton-line-heading"></div><div class="skeleton-line skeleton-line-copy"></div></div><div class="skeleton-pills"><div></div><div></div></div></section><section class="skeleton-panel"><div class="skeleton-tabs"><span></span><span></span><span></span><span></span><span></span></div><div class="skeleton-settings-content"><div class="skeleton-line skeleton-line-subheading"></div><div class="skeleton-fields"><div></div><div></div><div class="wide"></div><div class="wide tall"></div></div></div></section></div>
            break;
        default:
            <div class="skeleton-page" aria-hidden="true"><section class="skeleton-panel"><div class="skeleton-line skeleton-line-kicker"></div><div class="skeleton-line skeleton-line-heading"></div><div class="skeleton-line skeleton-line-copy"></div></section><section class="skeleton-panel"><div class="skeleton-pills"><div></div><div></div><div></div></div><div class="skeleton-line"></div><div class="skeleton-line"></div><div class="skeleton-line skeleton-line-short"></div></section></div>
            break;
    }
</div>

@code {
    [Parameter] public string Variant { get; set; } = "page";
    [Parameter] public int Count { get; set; } = 6;
}
